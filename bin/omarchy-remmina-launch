#!/usr/bin/env python3
"""
omarchy-remmina-launch — launch a remote connection
Usage: omarchy-remmina-launch <id>
       omarchy-remmina-launch --direct <protocol> <host> <port> <username>

For SSH/SFTP: uses xdg-terminal-exec -> ssh
For RDP: tries xfreerdp, else remmina -c rdp://...
For VNC: remmina -c vnc://...
For SPICE: remote-viewer spice://...
Disables Remmina tray icon side-effect via remmina.pref patch.

No passwords handled — SSH uses ssh config / keys, RDP uses freerdp/remmina dialog.
"""

import json
import os
import sys
import subprocess
import shlex
from pathlib import Path

HOME = Path(os.environ.get("HOME", str(Path.home())))
STORE_FILE = HOME / ".config" / "remmina-panel" / "servers.json"

def load_servers():
    if not STORE_FILE.exists():
        return []
    try:
        return json.loads(STORE_FILE.read_text(encoding="utf-8"))
    except:
        return []

def find_server(sid):
    for s in load_servers():
        if s.get("id") == sid:
            return s
    return None

def disable_remmina_tray():
    """Ensure Remmina tray icon is disabled (it breaks on Wayland/Hyprland)."""
    pref = HOME / ".config" / "remmina" / "remmina.pref"
    try:
        if not pref.exists():
            return
        txt = pref.read_text(encoding="utf-8", errors="ignore")
        if "disable_tray_icon=true" in txt:
            return
        # patch in place
        if "disable_tray_icon=" in txt:
            txt = txt.replace("disable_tray_icon=false", "disable_tray_icon=true")
        else:
            txt = txt.rstrip() + "\n" + "disable_tray_icon=true\n"
        pref.write_text(txt, encoding="utf-8")
    except Exception:
        pass

def which(cmd):
    import shutil
    return shutil.which(cmd)

def launch_ssh(host, port, username):
    target = f"{username}@{host}" if username else host
    ssh_cmd = ["ssh", target]
    if port:
        ssh_cmd += ["-p", str(port)]
    # Use xdg-terminal-exec so we honor Omarchy's default terminal (Alacritty/Foot/Ghostty/Kitty)
    if which("xdg-terminal-exec"):
        # xdg-terminal-exec -- ssh ...
        # needs -- separator
        cmd = ["xdg-terminal-exec", "--"] + ssh_cmd
    else:
        # fallback: try common terminals
        for term in [which("ghostty"), which("alacritty"), which("kitty"), which("foot")]:
            if term:
                if "kitty" in term:
                    cmd = [term, "-e"] + ssh_cmd
                elif "foot" in term:
                    cmd = [term, "-e"] + ssh_cmd
                elif "ghostty" in term:
                    cmd = [term, "-e"] + ssh_cmd
                else:
                    cmd = [term, "-e"] + ssh_cmd
                break
        else:
            cmd = ssh_cmd
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0

def launch_rdp(host, port, username, domain="", server_name=""):
    disable_remmina_tray()
    # Try to find an existing .remmina file for this server (imported from Remmina)
    # This preserves all original settings (gateway, security, etc.)
    try:
        rem_dir = HOME / ".local" / "share" / "remmina"
        if rem_dir.exists() and server_name:
            for f in rem_dir.glob("*.remmina"):
                try:
                    import configparser
                    cp = configparser.ConfigParser()
                    cp.read(f, encoding="utf-8")
                    if "remmina" in cp:
                        sec = cp["remmina"]
                        if sec.get("name","") == server_name and sec.get("server","").split(":")[0] == host.split(":")[0]:
                            cmd = ["remmina", "-c", str(f)]
                            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                            return 0
                except:
                    continue
    except:
        pass
    # Fallback: generate a temporary .remmina file for this server
    # This is more compatible than xfreerdp URI, as it uses Remmina's own freerdp wrapper
    try:
        import tempfile
        import configparser
        # Create a minimal .remmina for RDP
        cp = configparser.ConfigParser()
        cp["remmina"] = {
            "name": server_name or host,
            "server": f"{host}:{port}" if port else host,
            "protocol": "RDP",
            "username": username or "",
            "domain": domain or "",
            "password": "",
            "resolution_mode": "2",
            "colordepth": "99",
            "shareprinter": "0",
            "shareparallel": "0",
            "shareserial": "0",
            "sharesmartcard": "0",
            "sound": "off",
            "microphone": "",
            "cert_ignore": "1",
            "ignore-tls-errors": "1",
            "window_maximize": "1",
            "scale": "1",
            "viewmode": "1",
        }
        fd, tmp_path = tempfile.mkstemp(suffix=".remmina", prefix="omarchy-remmina-")
        with os.fdopen(fd, 'w', encoding="utf-8") as fo:
            cp.write(fo)
        cmd = ["remmina", "-c", tmp_path]
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    except:
        pass
    # Last fallback: xfreerdp / remmina URI
    if which("xfreerdp") or which("xfreerdp3"):
        bin_name = "xfreerdp3" if which("xfreerdp3") else "xfreerdp"
        v = f"{host}:{port}" if port else host
        args = [bin_name, f"/v:{v}"]
        if username:
            args.append(f"/u:{username}")
        if domain:
            args.append(f"/d:{domain}")
        args += ["/dynamic-resolution", "+clipboard", "/cert:ignore"]
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    user_part = ""
    if username:
        u = f"{domain}\\{username}" if domain and "\\" not in username else username
        safe_user = u.replace("@", "%40").replace(":", "%3A").replace("/", "%2F")
        user_part = safe_user + "@"
    port_part = f":{port}" if port else ""
    uri = f"rdp://{user_part}{host}{port_part}"
    cmd = ["remmina", "-c", uri]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0

def launch_vnc(host, port, username):
    disable_remmina_tray()
    # Try remmina VNC
    # remmina expects vnc://host[:port] or vnc://server?VncUsername=...
    port_part = f":{port}" if port else ""
    if username:
        uri = f"vnc://{host}{port_part}?VncUsername={username}"
    else:
        uri = f"vnc://{host}{port_part}"
    # If remote-viewer / vncviewer available? Remmina is canonical
    if which("remmina"):
        cmd = ["remmina", "-c", uri]
    elif which("vncviewer"):
        v = f"{host}:{port}" if port else host
        cmd = ["vncviewer", v]
    elif which("virt-viewer"):
        cmd = ["virt-viewer", uri]
    else:
        # fallback to remmina anyway
        cmd = ["remmina", "-c", uri]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0

def launch_spice(host, port, username):
    # SPICE via remote-viewer (virt-viewer)
    spice_port = port or "5900"
    uri = f"spice://{host}:{spice_port}"
    viewer = which("remote-viewer") or which("virt-viewer")
    if viewer:
        cmd = [viewer, uri]
    else:
        # fallback remmina
        cmd = ["remmina", "-c", uri]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0

def launch(protocol, host, port, username, domain="", server_name=""):
    p = (protocol or "RDP").upper()
    if p == "SSH" or p == "SFTP":
        return launch_ssh(host, port, username)
    elif p == "RDP":
        return launch_rdp(host, port, username, domain, server_name)
    elif p == "VNC":
        return launch_vnc(host, port, username)
    elif p == "SPICE":
        return launch_spice(host, port, username)
    else:
        disable_remmina_tray()
        proto = p.lower()
        uri = f"{proto}://{host}"
        if port:
            uri += f":{port}"
        subprocess.Popen(["remmina", "-c", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return 0

def main():
    if len(sys.argv) < 2:
        print("Usage: omarchy-remmina-launch <server-id>", file=sys.stderr)
        print("       omarchy-remmina-launch --direct <PROTO> <host> <port> <username> [domain]", file=sys.stderr)
        sys.exit(1)
    if sys.argv[1] == "--direct":
        if len(sys.argv) < 6:
            print("FAIL: --direct needs proto host port username [domain]", file=sys.stderr)
            sys.exit(1)
        proto, host, port, username = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
        domain = sys.argv[6] if len(sys.argv) > 6 else ""
        port = port if port and port != "-" else ""
        username = username if username and username != "-" else ""
        domain = domain if domain and domain != "-" else ""
        sys.exit(launch(proto, host, port, username, domain))
    sid = sys.argv[1]
    srv = find_server(sid)
    if not srv:
        print(f"FAIL: server {sid} not found", file=sys.stderr)
        sys.exit(1)
    host = srv.get("host", "")
    if not host:
        print("FAIL: host empty", file=sys.stderr)
        sys.exit(1)
    if any(c in host for c in ";&|`$(){}[]!#\"'"):
        print("FAIL: invalid host", file=sys.stderr)
        sys.exit(1)
    # Update lastUsed for Recent (fire-and-forget)
    try:
        import time
        servers = load_servers()
        for s in servers:
            if s.get("id") == sid:
                s["lastUsed"] = int(time.time() * 1000)
                if "favorite" not in s:
                    s["favorite"] = False
                Path(STORE_FILE).parent.mkdir(parents=True, exist_ok=True)
                tmp = STORE_FILE.with_suffix(".tmp")
                tmp.write_text(json.dumps(servers, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
                tmp.chmod(0o600)
                tmp.replace(STORE_FILE)
                break
    except Exception:
        pass
    sys.exit(launch(srv.get("protocol", "RDP"), host, srv.get("port", ""), srv.get("username", ""), srv.get("domain", ""), srv.get("name", "")))

if __name__ == "__main__":
    main()
