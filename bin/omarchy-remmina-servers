#!/usr/bin/env python3
"""
omarchy-remmina-servers — CRUD for servers.json
Storage: $HOME/.config/remmina-panel/servers.json
Schema: { id, name, host, protocol, port, username, group, notes }
Protocols: RDP, SSH, VNC, SPICE, SFTP, CUSTOM
Groups: free-form (e.g. Windows, Linux, Infra, Prod)
No secrets stored — no passwords.
"""

import json
import os
import sys
import re
import uuid
from pathlib import Path

HOME = Path(os.environ.get("HOME", str(Path.home())))
STORE_DIR = HOME / ".config" / "remmina-panel"
STORE_FILE = STORE_DIR / "servers.json"
GROUPS_FILE = STORE_DIR / "groups.json"

VALID_PROTOCOLS = {"RDP", "SSH", "VNC", "SPICE", "SFTP", "HTTP", "HTTPS", "CUSTOM"}
# Normalize input to upper
def normalize_protocol(p):
    if not p:
        return "RDP"
    u = str(p).strip().upper()
    if u in VALID_PROTOCOLS:
        return u
    # map common aliases
    alias = {
        "RDP": "RDP", "SSH": "SSH", "VNC": "VNC", "SPICE": "SPICE",
        "SFTP": "SSH", "FTP": "CUSTOM", "TELNET": "CUSTOM",
        "WWW": "HTTPS", "WEB": "HTTPS"
    }
    return alias.get(u, "CUSTOM")

def load_servers():
    if not STORE_FILE.exists():
        return []
    try:
        data = json.loads(STORE_FILE.read_text(encoding="utf-8"))
        if isinstance(data, list):
            return data
        if isinstance(data, dict) and "servers" in data:
            return data["servers"]
        return []
    except Exception:
        return []

def save_servers(servers):
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    # atomic write
    tmp = STORE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(servers, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(STORE_FILE)

def sanitize(s, max_len=128):
    if s is None:
        return ""
    s = str(s).strip()
    # remove control chars
    s = re.sub(r'[\x00-\x1f\x7f]', '', s)
    return s[:max_len]

def validate_server(obj, is_update=False):
    name = sanitize(obj.get("name"), 64)
    host = sanitize(obj.get("host"), 253)
    if not name:
        return None, "name is required"
    if not host:
        return None, "host is required"
    if not re.match(r'^[a-zA-Z0-9][a-zA-Z0-9._\-]*$', host):
        if not re.match(r'^[\[a-fA-F0-9:\]]+$', host) and not re.match(r'^[a-zA-Z0-9.\-_:]+$', host):
            return None, "invalid host"
    protocol = normalize_protocol(obj.get("protocol"))
    port_raw = obj.get("port")
    port = ""
    if port_raw not in (None, "", 0):
        try:
            p = int(str(port_raw).strip())
            if 1 <= p <= 65535:
                port = str(p)
            else:
                return None, "port out of range 1-65535"
        except:
            return None, "invalid port"
    username = sanitize(obj.get("username"), 64)
    domain = sanitize(obj.get("domain"), 64)
    group = sanitize(obj.get("group"), 64) or "General"
    notes = sanitize(obj.get("notes"), 256)
    # favorite + lastUsed (persist across updates)
    favorite = bool(obj.get("favorite") is True or str(obj.get("favorite")).lower() in ("1","true","yes"))
    # lastUsed: epoch ms, 0 if never
    last_used_raw = obj.get("lastUsed") or obj.get("last_used") or 0
    try:
        last_used = int(last_used_raw) if str(last_used_raw).strip() != "" else 0
        if last_used < 0: last_used = 0
    except:
        last_used = 0

    server = {
        "id": sanitize(obj.get("id"), 64) or str(uuid.uuid4()),
        "name": name,
        "host": host,
        "protocol": protocol,
        "port": port,
        "username": username,
        "domain": domain,
        "group": group,
        "notes": notes,
        "favorite": favorite,
        "lastUsed": last_used
    }
    return server, None

def cmd_list():
    servers = load_servers()
    print(json.dumps(servers, ensure_ascii=False))
    return 0

def cmd_get(sid):
    servers = load_servers()
    for s in servers:
        if s.get("id") == sid:
            print(json.dumps(s, ensure_ascii=False))
            return 0
    print(json.dumps({"error": "not found"}))
    return 1

def cmd_add():
    raw = sys.stdin.read()
    if not raw.strip():
        print("FAIL: empty stdin", file=sys.stderr)
        return 1
    try:
        obj = json.loads(raw)
    except Exception as e:
        print(f"FAIL: invalid json: {e}", file=sys.stderr)
        return 1
    server, err = validate_server(obj)
    if err:
        print(f"FAIL: {err}", file=sys.stderr)
        return 1
    servers = load_servers()
    # ensure id unique
    if any(s.get("id") == server["id"] for s in servers):
        server["id"] = str(uuid.uuid4())
    # name uniqueness? allow duplicate but warn
    servers.append(server)
    save_servers(servers)
    print(json.dumps(server, ensure_ascii=False))
    return 0

def cmd_update(sid):
    raw = sys.stdin.read()
    try:
        obj = json.loads(raw) if raw.strip() else {}
    except Exception as e:
        print(f"FAIL: invalid json: {e}", file=sys.stderr)
        return 1
    servers = load_servers()
    existing = next((s for s in servers if s.get("id") == sid), None)
    if not existing:
        print("FAIL: not found", file=sys.stderr)
        return 1
    # Preserve favorite/lastUsed if not explicitly provided
    if "favorite" not in obj and "favourite" not in obj:
        obj["favorite"] = existing.get("favorite", False)
    if "lastUsed" not in obj and "last_used" not in obj:
        obj["lastUsed"] = existing.get("lastUsed", 0)
    obj["id"] = sid
    server, err = validate_server(obj)
    if err:
        print(f"FAIL: {err}", file=sys.stderr)
        return 1
    for i, s in enumerate(servers):
        if s.get("id") == sid:
            servers[i] = server
            save_servers(servers)
            print(json.dumps(server, ensure_ascii=False))
            return 0
    print("FAIL: not found", file=sys.stderr)
    return 1

def cmd_favorite(sid, val):
    servers = load_servers()
    for i, s in enumerate(servers):
        if s.get("id") == sid:
            servers[i]["favorite"] = bool(val)
            # Ensure lastUsed exists
            if "lastUsed" not in servers[i]:
                servers[i]["lastUsed"] = 0
            save_servers(servers)
            print(json.dumps(servers[i], ensure_ascii=False))
            return 0
    print("FAIL: not found", file=sys.stderr)
    return 1

def cmd_touch(sid):
    import time
    servers = load_servers()
    for i, s in enumerate(servers):
        if s.get("id") == sid:
            servers[i]["lastUsed"] = int(time.time() * 1000)
            if "favorite" not in servers[i]:
                servers[i]["favorite"] = False
            save_servers(servers)
            print(json.dumps(servers[i], ensure_ascii=False))
            return 0
    print("FAIL: not found", file=sys.stderr)
    return 1

def cmd_delete(sid):
    servers = load_servers()
    new = [s for s in servers if s.get("id") != sid]
    if len(new) == len(servers):
        print("FAIL: not found", file=sys.stderr)
        return 1
    save_servers(new)
    print("OK")
    return 0

def load_groups():
    if not GROUPS_FILE.exists():
        return []
    try:
        data = json.loads(GROUPS_FILE.read_text(encoding="utf-8"))
        if isinstance(data, list):
            # Support both old string list and new object list {name, glyph}
            out=[]
            for x in data:
                if isinstance(x, str):
                    out.append({"name": x, "glyph": ""})
                elif isinstance(x, dict) and "name" in x:
                    out.append({"name": sanitize(x.get("name"),64), "glyph": sanitize(x.get("glyph"),8)})
            return out
        return []
    except:
        return []

def save_groups(groups):
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    # groups is list of {name, glyph}
    uniq={}
    for g in groups:
        if isinstance(g, dict) and g.get("name"):
            uniq[g["name"]] = g.get("glyph","")
        elif isinstance(g, str) and g:
            uniq[g] = ""
    out=[{"name": k, "glyph": v} for k,v in sorted(uniq.items())]
    tmp = GROUPS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(out, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(GROUPS_FILE)

def load_groups_names():
    return [g["name"] for g in load_groups()]

def cmd_groups():
    servers = load_servers()
    groups = {}
    for s in servers:
        g = s.get("group") or "General"
        groups[g] = groups.get(g, 0) + 1
    out = [{"group": k, "count": v} for k, v in sorted(groups.items())]
    print(json.dumps(out, ensure_ascii=False))
    return 0

def cmd_groups_json():
    print(json.dumps(load_groups(), ensure_ascii=False))
    return 0

def cmd_group_add(name, glyph=""):
    name = sanitize(name, 64)
    glyph = sanitize(glyph, 8)
    if not name or name in ("Favorites", "Recent", "Windows", "Linux"):
        print("FAIL: invalid group name", file=sys.stderr)
        return 1
    groups = load_groups()
    names = [g["name"] for g in groups]
    if name not in names:
        groups.append({"name": name, "glyph": glyph})
        save_groups(groups)
    print(json.dumps(groups, ensure_ascii=False))
    return 0

def cmd_group_rename(old, new):
    old = sanitize(old, 64)
    new = sanitize(new, 64)
    if not old or not new or old in ("Favorites", "Recent") or new in ("Favorites", "Recent"):
        print("FAIL: invalid group", file=sys.stderr)
        return 1
    groups = load_groups()
    found=False
    for g in groups:
        if g["name"] == old:
            g["name"] = new
            found=True
    if found:
        save_groups(groups)
    servers = load_servers()
    changed=False
    for s in servers:
        if (s.get("group") or "General") == old:
            s["group"] = new
            changed=True
    if changed:
        save_servers(servers)
    print("OK")
    return 0

def cmd_group_delete(name):
    name = sanitize(name, 64)
    if not name or name in ("Favorites", "Recent", "Windows", "Linux", "General"):
        print("FAIL: cannot delete default/virtual", file=sys.stderr)
        return 1
    groups = load_groups()
    groups = [g for g in groups if g["name"] != name]
    save_groups(groups)
    servers = load_servers()
    changed=False
    for s in servers:
        if (s.get("group") or "General") == name:
            s["group"] = "General"
            changed=True
    if changed:
        save_servers(servers)
    print("OK")
    return 0

def cmd_group_set_glyph(name, glyph):
    name = sanitize(name, 64)
    glyph = sanitize(glyph, 8)
    if not name or name in ("Favorites", "Recent", "Windows", "Linux"):
        print("FAIL: invalid group", file=sys.stderr)
        return 1
    groups = load_groups()
    for g in groups:
        if g["name"] == name:
            g["glyph"] = glyph
            save_groups(groups)
            print(json.dumps(groups, ensure_ascii=False))
            return 0
    # If not found, add it
    groups.append({"name": name, "glyph": glyph})
    save_groups(groups)
    print(json.dumps(groups, ensure_ascii=False))
    return 0

def cmd_move(sid, new_group):
    new_group = sanitize(new_group, 64) or "General"
    if new_group in ("⭐ Favorites", "🕘 Recent"):
        print("FAIL: cannot move to virtual group", file=sys.stderr)
        return 1
    servers = load_servers()
    for s in servers:
        if s.get("id") == sid:
            s["group"] = new_group
            save_servers(servers)
            print(json.dumps(s, ensure_ascii=False))
            return 0
    print("FAIL: not found", file=sys.stderr)
    return 1

def cmd_stats():
    servers = load_servers()
    total = len(servers)
    # classify: RDP -> windows, SSH/VNC/SPICE -> linux, rest other
    windows = sum(1 for s in servers if s.get("protocol") == "RDP")
    linux = sum(1 for s in servers if s.get("protocol") in ("SSH", "VNC", "SPICE", "SFTP"))
    other = total - windows - linux
    groups = {}
    for s in servers:
        g = s.get("group") or "General"
        groups[g] = groups.get(g, 0) + 1
    print(json.dumps({
        "total": total,
        "windows": windows,
        "linux": linux,
        "other": other,
        "groups": groups
    }, ensure_ascii=False))
    return 0

def usage():
    print("""Usage: omarchy-remmina-servers <command>

Commands:
  list                 List all servers (JSON array to stdout)
  get <id>             Get single server
  add                  Add server (read JSON from stdin)
  update <id>          Update server (read JSON from stdin)
  delete <id>          Delete server
  groups               List groups with counts
  groups-json          List empty custom groups
  group-add <name>     Add empty custom group
  group-rename <old> <new>  Rename group (updates servers)
  group-delete <name>  Delete empty group (moves servers to General)
  move <id> <group>    Move server to group
  stats                Stats: total/windows/linux/other
  favorite <id> <0|1>  Toggle favorite
  touch <id>           Update lastUsed to now (for Recent)
  help
Expected JSON for add/update:
  { name, host, protocol(RDP|SSH|VNC|SPICE), port, username, domain, group, notes, favorite, lastUsed }
""", file=sys.stderr)

if __name__ == "__main__":
    if len(sys.argv) < 2:
        usage()
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "list":
        sys.exit(cmd_list())
    elif cmd == "get" and len(sys.argv) == 3:
        sys.exit(cmd_get(sys.argv[2]))
    elif cmd == "add":
        sys.exit(cmd_add())
    elif cmd == "update" and len(sys.argv) == 3:
        sys.exit(cmd_update(sys.argv[2]))
    elif cmd == "delete" and len(sys.argv) == 3:
        sys.exit(cmd_delete(sys.argv[2]))
    elif cmd == "groups":
        sys.exit(cmd_groups())
    elif cmd == "groups-json":
        sys.exit(cmd_groups_json())
    elif cmd == "group-add" and len(sys.argv) >= 3:
        glyph = sys.argv[3] if len(sys.argv) > 3 else ""
        sys.exit(cmd_group_add(sys.argv[2], glyph))
    elif cmd == "group-rename" and len(sys.argv) == 4:
        sys.exit(cmd_group_rename(sys.argv[2], sys.argv[3]))
    elif cmd == "group-delete" and len(sys.argv) == 3:
        sys.exit(cmd_group_delete(sys.argv[2]))
    elif cmd == "group-glyph" and len(sys.argv) == 4:
        sys.exit(cmd_group_set_glyph(sys.argv[2], sys.argv[3]))
    elif cmd == "move" and len(sys.argv) == 4:
        sys.exit(cmd_move(sys.argv[2], sys.argv[3]))
    elif cmd == "stats":
        sys.exit(cmd_stats())
    elif cmd == "favorite" and len(sys.argv) == 4:
        v = sys.argv[3].lower() in ("1","true","yes","on")
        sys.exit(cmd_favorite(sys.argv[2], v))
    elif cmd == "touch" and len(sys.argv) == 3:
        sys.exit(cmd_touch(sys.argv[2]))
    elif cmd in ("help", "--help", "-h"):
        usage()
        sys.exit(0)
    else:
        usage()
        sys.exit(1)
